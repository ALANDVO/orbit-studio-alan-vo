{
  "realm": "orbit-studio",
  "enabled": true,
  "displayName": "Orbit Studio",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "viewer", "description": "Read-only access to issues" },
      { "name": "operator", "description": "Can create and update issues" },
      { "name": "admin", "description": "Full administrative access" }
    ],
    "client": {}
  },
  "clients": [
    {
      "clientId": "orbit-studio-frontend",
      "name": "Orbit Studio Frontend",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-secret-change-in-production",
      "redirectUris": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
      "webOrigins": ["http://localhost:3000", "http://127.0.0.1:3000"],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": false,
      "protocol": "openid-connect",
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "access.token.lifespan": "900",
        "refresh.token.max.reuse": "0"
      },
      "defaultRoles": ["viewer"],
      "roles": {
        "realm": ["viewer", "operator", "admin"]
      }
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@example.com",
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "demo123",
          "temporary": false
        }
      ],
      "realmRoles": ["operator"]
    },
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@example.com",
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["admin"]
    }
  ]
}